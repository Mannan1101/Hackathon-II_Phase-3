# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database_name

# Security
SECRET_KEY=your-secret-key-min-32-chars-long-change-in-production

# Better Auth (if using API key mode)
BETTER_AUTH_API_KEY=your-better-auth-api-key

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

# AI Chatbot Configuration (Feature: 001-todo-ai-chatbot)
# Get your API key from: https://dashboard.cohere.ai/api-keys
# Note: command-r was deprecated on Sept 15, 2025. Use command-r-plus or command-r7b-12-2024
COHERE_API_KEY=your_cohere_api_key_here
CHATBOT_MODEL=command-r-plus
CHATBOT_MAX_TOKENS=500
CHATBOT_TEMPERATURE=0.7
